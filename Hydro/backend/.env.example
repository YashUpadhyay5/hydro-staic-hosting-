# HRMS Express Backend Configuration

# Application Port
PORT=8000

# Database Configuration (PostgreSQL Localhost Setup)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=company_hrms
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD
DB_SSL=false

# Optional Legacy Database URL override (e.g. Neon, if you want to override separate fields)
# DATABASE_URL=postgresql://user:password@host:port/database

# Persistent Local Storage Base Path (Default is ../storage relative to backend/)
# STORAGE_PATH=C:\Users\Falcon\Desktop\hrms\storage
STORAGE_PATH=../storage


