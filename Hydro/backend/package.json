{
  "name": "hrms-expense-backend",
  "version": "1.0.0",
  "description": "Node.js Express backend for HRMS Expense Management",
  "main": "server.js",
  "scripts": {
    "start": "node src/server.js",
    "cluster": "pm2 start ecosystem.config.js",
    "cluster:reload": "pm2 reload hydro-express-backend",
    "cluster:scale": "pm2 scale hydro-express-backend",
    "cluster:stop": "pm2 stop hydro-express-backend",
    "cluster:status": "pm2 list",
    "dev": "nodemon src/server.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "apicache": "^1.6.3",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "firebase-admin": "^12.7.0",
    "http-proxy-middleware": "^4.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.2",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.20.2",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "sqlite3": "^6.0.1",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
